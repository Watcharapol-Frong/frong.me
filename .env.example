# ============================================================================
# frong.me — Environment Variable SSOT (Single Source of Truth)
# ============================================================================
# This file lists NAMES ONLY. Never commit real values.
# Canonical definitions live in docs/cms/environment-map.md ("SSOT" section).
#
# GitHub Environments mapping (cms-staging):
#   Secrets     -> GitHub Environment Secrets
#   Variables   -> GitHub Environment Variables (non-secret)
# ============================================================================
#
# Cloudflare account and D1
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_DATABASE_NAME=
CF_D1_READ_TOKEN=
CF_DEPLOY_TOKEN=

# Legacy combined token; the staging workflow uses the restricted tokens above.
CF_API_TOKEN=

# CMS staging release and deployment
CMS_SITE_ORIGIN=
CMS_SPIKE_DEPLOY=true
STAGING_D1_DATABASE_ID=
STAGING_R2_BUCKET_NAME=

# GitHub Dispatch (for triggering build on publish)
GITHUB_REPO=Watcharapol-Frong/frong.me
GITHUB_DISPATCH_TOKEN=

# Release confirmation/failure callback (scripts/build/cms-staging-deploy.yml -> /confirm, /fail).
# Independent of Cloudflare Access so a leaked Access service token alone cannot
# forge a deployment outcome; the callback also requires this secret header.
RELEASE_CALLBACK_SECRET=

# AI Worker Integration (Server-side proxy)
AI_WORKER_URL=https://ai-assistant-worker.frongbook.workers.dev
AI_WORKER_SECRET=

# Cloudflare Access
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAIL=
# Local development only; production middleware also requires import.meta.env.DEV.
ENABLE_ACCESS_DEV_BYPASS=false
# Service Token credentials for automated verification (scripts/build/verify-access-staging.mjs)
STAGING_HOST=https://cms-staging.frong.me
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Future Phase 3 & 4 (Optional for now)
# ENCRYPTION_KEY=
# TURNSTILE_SECRET_KEY=
# PUBLIC_TURNSTILE_SITE_KEY=
# RESEND_API_KEY=
