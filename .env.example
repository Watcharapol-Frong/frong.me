# Configuration names only. Never commit credentials.
# Consumers and storage locations: docs/cms/environment-map.md

# Optional build-time public analytics identifier (format: G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=

# Authorized local deployment / Wrangler commands
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Staging preflight (must match wrangler.jsonc)
CF_D1_DATABASE_ID=
CF_R2_BUCKET_NAME=

# Main Worker Access configuration; also required by staging preflight
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Development only. Never enable in shared environments.
ENABLE_ACCESS_DEV_BYPASS=false

# Optional read-only D1 HTTP verification
CF_ACCOUNT_ID=
CF_D1_DATABASE_NAME=
CF_D1_READ_TOKEN=

# Optional authorized staging Access verification
CMS_STAGING_HOST=https://frong-me-staging.frongbook.workers.dev
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
CF_ACCESS_JWT_ASSERTION=

# Optional server-side AI fallback keys; Earth also stores provider settings
GEMINI_API_KEY=
OPENROUTER_API_KEY=
