---
import "../styles/global.css";
import { getImage } from "astro:assets";
import ogFallback from "../assets/og-fallback.svg";
import Analytics from "../components/Analytics.astro";
import {
  buildSeoMetadata,
  type ArticleSeo,
  type ProfileSeo,
  type WebsiteSeo,
} from "../lib/seo.ts";

type LayoutImage = ImageMetadata | string;
type LayoutSeo =
  | (Omit<WebsiteSeo, "image"> & { image?: LayoutImage })
  | (Omit<ProfileSeo, "image"> & { image?: LayoutImage })
  | (Omit<ArticleSeo, "image"> & { image?: LayoutImage });

interface Props {
  seo?: LayoutSeo;
}

const seo = Astro.props.seo ?? {};
const { image, ...seoInput } = seo;

let ogImageURL: URL;
if (typeof image === "string") {
  ogImageURL = new URL(image);
} else {
  const optimizedOgImage = await getImage({
    src: image ?? ogFallback,
    width: 1200,
    height: 630,
    fit: "cover",
    format: "jpeg",
    quality: 80,
  });
  ogImageURL = new URL(optimizedOgImage.src, Astro.site);
}

const metadata = buildSeoMetadata(
  { ...seoInput, image: ogImageURL.toString() },
  {
    siteUrl: Astro.site!.toString(),
    pathname: Astro.url.pathname,
    defaultImageUrl: ogImageURL.toString(),
  },
);
const structuredData = JSON.stringify(metadata.structuredData).replace(/</g, '\\u003c');
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!DOCTYPE html>
<html lang={metadata.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const isDark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <meta name="author" content="Watcharapol Charoensuk" />
    <meta name="robots" content={metadata.noIndex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />

    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:type" content={metadata.openGraphType} />
    <meta property="og:url" content={metadata.canonicalUrl} />
    <meta property="og:locale" content={metadata.locale} />
    <meta property="og:site_name" content="frong.me" />
    <meta property="og:image" content={metadata.imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Frong_wc" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content={metadata.imageUrl} />

    <link rel="canonical" href={metadata.canonicalUrl} />
    <script type="application/ld+json" set:html={structuredData} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600&family=Google+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <slot />
    <Analytics measurementId={gaMeasurementId} />
  </body>
</html>
