---
import "../styles/global.css";
import { getImage } from "astro:assets";
import ogFallback from "../assets/og-fallback.svg";

interface Props {
  title?: string;
  description?: string;
  ogImage?: ImageMetadata | string;
}

const {
  title = "frong.me",
  description = "Portfolio of Watcharapol Charoensuk (Frong) - Connecting Data to Business, and Strategy to Impact. Passionate about data analytics, AI, and design thinking.",
  ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

let ogImageURL: URL;
if (typeof ogImage === "string") {
  ogImageURL = new URL(ogImage);
} else {
  const optimizedOgImage = await getImage({
    src: ogImage ?? ogFallback,
    width: 1200,
    height: 630,
    fit: "cover",
    format: "jpeg",
    quality: 80,
  });
  ogImageURL = new URL(optimizedOgImage.src, Astro.site);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const isDark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Watcharapol Charoensuk" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Frong_wc" />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="canonical" href={canonicalURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600&family=Google+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <slot />
  </body>
</html>
