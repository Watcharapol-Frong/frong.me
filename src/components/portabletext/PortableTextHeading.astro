---
import { slugify, nodeText } from "@/lib/slugify";

const { node } = Astro.props as { node: { style?: string; children?: unknown[] } };
const text = nodeText(node.children as never);
const slug = slugify(text);
---

{node.style === "h3" ? (
  <h3 id={slug}><slot /></h3>
) : (
  <h2 id={slug}><slot /></h2>
)}
