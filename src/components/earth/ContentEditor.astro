---
/**
 * The writing surface: the cover preview above a single auto-growing Markdown
 * textarea. No split preview — Preview opens a new tab (Ctrl+P) so the
 * writing column keeps the full width of the page.
 *
 * Markup only — behaviour is wired by the delegated script in
 * `PostEditor.astro`, styling lives in `src/pages/earth/editor.astro`.
 */
export interface ContentEditorProps {
  initial?: string;
  coverUrl?: string;
}

interface Props extends ContentEditorProps {}

const { initial = '', coverUrl = '' } = Astro.props as Props;
---

<div class="editor-scroll" data-earth-scroll data-earth-image-drop>
  <figure class="cover-container" data-earth-cover-container hidden={!coverUrl}>
    <img class="cover-preview" data-earth-cover-preview src={coverUrl} alt="Cover preview" draggable="false" />
    <div class="cover-controls" data-earth-cover-controls>
      <button type="button" class="cover-ctrl-btn" data-earth-action="cover-zoom-out" title="Zoom out">−</button>
      <span class="cover-zoom-label" data-earth-cover-zoom-label>1.0x</span>
      <button type="button" class="cover-ctrl-btn" data-earth-action="cover-zoom-in" title="Zoom in">+</button>
      <button type="button" class="cover-ctrl-btn" data-earth-action="cover-reset-position" title="Reset position">Reset</button>
    </div>
    <div class="cover-drag-hint" data-earth-cover-drag-hint>Drag to reposition</div>
  </figure>

  <textarea
    class="body-input"
    data-earth-field="body"
    placeholder="Start writing…  (Ctrl+I to add an image, Ctrl+E for emoji)"
    spellcheck="true"
  >{initial}</textarea>

  <div class="drop-indicator" data-earth-drop-indicator hidden>Drop the image to upload it…</div>
</div>

<div class="emoji-picker" data-earth-emoji-picker hidden></div>
