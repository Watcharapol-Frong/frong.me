---
/**
 * Left sidebar: slug (with live URL preview), reading font, cover image,
 * excerpt, primary topic, tags, and two collapsible reference panels
 * (Markdown syntax and editor shortcuts).
 *
 * Markup only — behaviour is wired by the delegated script in
 * `PostEditor.astro`, styling lives in `src/pages/earth/editor.astro`.
 */
export interface MetadataFormProps {
  initial?: {
    slug?: string;
    excerpt?: string;
    tags?: string[];
    primaryTopic?: 'data' | 'technology' | 'business' | null;
    font?: string;
    coverUrl?: string;
    jsonLd?: boolean;
    status?: 'draft' | 'published';
  };
  siteDomain?: string;
}

interface Props extends MetadataFormProps {}

const { initial = {}, siteDomain = 'frong.me' } = Astro.props as Props;

const status = initial.status ?? 'draft';
const tags = (initial.tags ?? []).join(', ');
const primaryTopics = [
  { value: 'data', label: 'Data' },
  { value: 'technology', label: 'Technology' },
  { value: 'business', label: 'Business' },
] as const;

const FONTS = [
  { value: 'google-sans', label: 'Google Sans' },
  { value: 'crimson-pro', label: 'Crimson Pro' },
  { value: 'jetbrains-mono', label: 'JetBrains Mono' },
  { value: 'ibm-plex-sans-thai', label: 'IBM Plex Sans Thai' },
];
const font = initial.font ?? FONTS[0].value;

const MARKDOWN_HELP = [
  ['# H1', '## H2', '### H3'],
  ['**bold**', '*italic*'],
  ['- list item'],
  ['1. numbered'],
  ['> blockquote'],
  ['`code`', '```code block```'],
  ['[link](url)', '![img](url)'],
  ['@[youtube](videoId)'],
  ['---'],
];

const SHORTCUTS: { keys: string[]; label: string }[] = [
  { keys: ['Ctrl', 'S'], label: 'Save draft' },
  { keys: ['Ctrl', 'B'], label: 'Bold' },
  { keys: ['Ctrl', 'E'], label: 'Emoji' },
  { keys: ['Ctrl', 'I'], label: 'Images' },
  { keys: ['Ctrl', 'Shift', 'Y'], label: 'YouTube' },
  { keys: ['Ctrl', 'M'], label: 'Portal' },
  { keys: ['Ctrl', '/'], label: 'Zen mode' },
];
---

<aside class="sidebar" data-earth-meta data-earth-sidebar="left">
  <input type="hidden" data-earth-field="status" value={status} />

  <div class="form-group">
    <label class="form-label" for="earth-slug">
      <span>Article URL name</span>
      <span class="form-label-right">
        <span class="form-label-hint" data-earth-slug-mode>auto</span>
        <button type="button" class="ai-inline-btn" data-earth-ai-inline="auto-slug">✨ AI</button>
      </span>
    </label>
    <input
      id="earth-slug"
      type="text"
      class="form-input"
      data-earth-field="slug"
      value={initial.slug ?? ''}
      placeholder="post-url-slug"
      pattern="[a-z0-9]+(-[a-z0-9]+)*"
      maxlength="120"
      title="Lowercase English letters, numbers, and hyphens only"
      autocomplete="off"
    />
    <div class="slug-preview">{siteDomain}/articles/<span data-earth-slug-preview>your-slug</span></div>
  </div>

  <div class="form-group">
    <label class="form-label" for="earth-font">Font</label>
    <select id="earth-font" class="form-input form-select" data-earth-field="font">
      {FONTS.map((option) => (
        <option value={option.value} selected={font === option.value}>{option.label}</option>
      ))}
    </select>
  </div>

  <div class="form-group">
    <label class="form-label" for="earth-cover">
      Cover image (<a
        href="https://unsplash.com"
        target="_blank"
        rel="noopener noreferrer"
        class="form-label-link">Unsplash</a>)
    </label>
    <input
      id="earth-cover"
      type="url"
      class="form-input"
      data-earth-field="coverUrl"
      value={initial.coverUrl ?? ''}
      placeholder="https://…"
      autocomplete="off"
    />
    <div class="inspire-row">
      <button type="button" class="inspire-btn" data-earth-action="pick-cover">↑ Upload</button>
      <button type="button" class="inspire-btn" data-earth-action="clear-cover">✕ Clear</button>
      <span class="inspire-loading" data-earth-cover-status></span>
    </div>
    <input type="file" accept="image/png,image/jpeg,image/webp" data-earth-cover-file hidden />
    <div class="cover-upload-error" data-earth-cover-error hidden></div>
  </div>

  <div class="form-group">
    <label class="form-label" for="earth-excerpt">
      <span>Excerpt</span>
      <button type="button" class="ai-inline-btn" data-earth-ai-inline="auto-excerpt">✨ AI</button>
    </label>
    <textarea
      id="earth-excerpt"
      class="form-input"
      rows="5"
      maxlength="160"
      data-earth-field="excerpt"
      placeholder="Brief summary…">{initial.excerpt ?? ''}</textarea>
  </div>

  <div class="form-group">
    <fieldset class="topic-fieldset">
      <legend class="form-label">Primary topic</legend>
      <div class="topic-segments">
        {primaryTopics.map((topic) => (
          <label class="topic-segment">
            <input
              type="radio"
              name="primary-topic"
              value={topic.value}
              data-earth-field="primaryTopic"
              checked={initial.primaryTopic === topic.value}
            />
            <span>{topic.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>

  <div class="form-group">
    <label class="form-label" for="earth-tag-input">
      <span>Tags</span>
      <button type="button" class="ai-inline-btn" data-earth-ai-inline="auto-tags">✨ AI</button>
    </label>
    <input
      id="earth-tags"
      type="hidden"
      data-earth-field="tags"
      value={tags}
    />
    <div class="tag-picker" data-earth-tag-picker>
      <div class="tag-picker-field">
        <div class="tag-picker-chips" data-earth-tag-chips></div>
        <input
          id="earth-tag-input"
          type="text"
          class="tag-picker-input"
          data-earth-tag-input
          placeholder="Add a tag…"
          autocomplete="off"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="earth-tag-options"
        />
      </div>
      <div id="earth-tag-options" class="tag-picker-options" data-earth-tag-options role="listbox" hidden></div>
    </div>
  </div>

  <div class="form-group">
    <label class="form-label form-label-row">
      <input type="checkbox" data-earth-field="jsonLd" checked={initial.jsonLd ?? true} />
      JSON-LD Article schema
    </label>
    <!-- Collapsed by default: the schema is still embedded in the published
         page either way, this raw dump is only for authors who want to check it. -->
    <details class="schema-details">
      <summary>Preview raw JSON-LD</summary>
      <pre class="schema-preview" data-earth-jsonld-preview hidden></pre>
    </details>
  </div>

  <div class="markdown-help">
    <button type="button" class="help-toggle" data-earth-action="toggle-help" aria-expanded="false">
      <span data-earth-help-icon>+</span> Markdown Help
    </button>
    <div class="help-content" data-earth-help-content hidden>
      {MARKDOWN_HELP.map((row) => (
        <p>{row.map((code) => <code>{code}</code>)}</p>
      ))}
    </div>
  </div>

  <div class="markdown-help">
    <button type="button" class="help-toggle" data-earth-action="toggle-shortcuts" aria-expanded="false">
      <span data-earth-shortcuts-icon>+</span> Editor Shortcuts
    </button>
    <div class="help-content" data-earth-shortcuts-content hidden>
      {SHORTCUTS.map((shortcut) => (
        <p>
          {shortcut.keys.map((key, index) => (
            <>{index > 0 && '+'}<kbd>{key}</kbd></>
          ))}
          <span class="shortcut-label">{shortcut.label}</span>
        </p>
      ))}
    </div>
  </div>
</aside>
