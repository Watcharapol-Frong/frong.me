---
/**
 * Editor header: wordmark, live save status, counters, and the Save / Preview
 * / Publish / Unpublish actions. Publish and Unpublish each slide out an
 * inline "Sure? Yes / No" rather than opening a dialog, so a destructive flip
 * always takes two deliberate clicks without stealing focus from the draft.
 *
 * Markup only — every click is handled by the delegated script in
 * `PostEditor.astro`, and all styling lives in `src/pages/earth/editor.astro`.
 */
export interface ActionBarProps {
  status?: 'draft' | 'active';
}

interface Props extends ActionBarProps {}

const { status = 'draft' } = Astro.props as Props;
---

<header class="header">
  <div class="header-left">
    <a href="/earth" class="logo" title="Back to the portal (Ctrl+M)">EARTH</a>
    <div class="save-status" data-earth-save-status role="status" aria-live="polite"></div>
  </div>

  <div class="header-actions">
    <span class="word-count-header">
      <span data-earth-count="words">0</span> words · <span data-earth-count="chars">0</span> chars<span
        class="count-sep"
      > | </span>Title: <span data-earth-count="title">0</span>/60 · Excerpt:
      <span data-earth-count="excerpt">0</span>/160
    </span>

    <button
      type="button"
      class="header-btn header-btn-secondary"
      data-earth-action="save-draft"
      title="Save draft (Ctrl+S)"
    >
      Save
    </button>

    <button
      type="button"
      class="header-btn header-btn-secondary"
      data-earth-action="preview"
      title="Preview in a new tab (Ctrl+P)"
    >
      Preview
    </button>

    <span class="publish-confirm-wrap" data-earth-publish-wrap hidden={status === 'active'}>
      <button type="button" class="header-btn header-btn-primary" data-earth-action="publish-toggle">
        Publish
      </button>
      <span class="publish-confirm" data-earth-publish-confirm>
        <span class="publish-confirm-label">Sure?</span>
        <button type="button" class="confirm-yes" data-earth-action="publish-confirm">Yes</button>
        <button type="button" class="confirm-no" data-earth-action="publish-cancel">No</button>
      </span>
    </span>

    <span class="publish-confirm-wrap" data-earth-unpublish-wrap hidden={status !== 'active'}>
      <button type="button" class="header-btn header-btn-danger" data-earth-action="unpublish-toggle">
        Unpublish
      </button>
      <span class="publish-confirm" data-earth-unpublish-confirm>
        <span class="publish-confirm-label">Sure?</span>
        <button type="button" class="confirm-yes confirm-yes-danger" data-earth-action="unpublish-confirm">Yes</button>
        <button type="button" class="confirm-no" data-earth-action="unpublish-cancel">No</button>
      </span>
    </span>
  </div>
</header>
