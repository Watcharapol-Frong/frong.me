---
/**
 * Earth editor — composition root.
 *
 * Header (`ActionBar`) over three columns: metadata sidebar (`MetadataForm`),
 * the writing surface (`ContentEditor`), and the AI Assistant (`AiPanel`,
 * which owns its own script). Ctrl+/ collapses both sidebars into Zen mode.
 *
 * One delegated script below owns everything else:
 *
 * - Field collection into the strict posts wire contract.
 * - Same-origin create, fetch, versioned update, and direct publish/unpublish
 *   (no release step — see `src/lib/cms/client/post-editor-api.ts`).
 * - Local draft backup: debounced autosave to `localStorage`, restore on
 *   load, and a "saved HH:MM:SS" indicator.
 * - Cover and body image upload straight to R2, auto-slug from the title,
 *   live counters, the emoji/image/YouTube inserts, and every shortcut.
 *
 * Styling for all four components lives in `src/pages/earth/editor.astro`.
 */
import MetadataForm from './MetadataForm.astro';
import ContentEditor from './ContentEditor.astro';
import ActionBar from './ActionBar.astro';
import AiPanel from './AiPanel.astro';

export interface PostEditorProps {
  initial?: {
    id?: string;
    lang?: 'th' | 'en';
    title?: string;
    slug?: string;
    excerpt?: string;
    tags?: string[];
    font?: string;
    coverUrl?: string;
    status?: 'draft' | 'active';
    body?: string;
  };
  storageKey?: string;
  siteDomain?: string;
}

interface Props extends PostEditorProps {}

const { initial = {}, storageKey, siteDomain = 'frong.me' } = Astro.props as Props;

const resolvedKey = storageKey ?? `earth:draft:${initial.id ?? 'new'}`;
const seed = {
  id: initial.id ?? '',
  lang: initial.lang ?? ('th' as const),
  title: initial.title ?? '',
  slug: initial.slug ?? '',
  excerpt: initial.excerpt ?? '',
  tags: initial.tags ?? [],
  font: initial.font ?? 'google-sans',
  coverUrl: initial.coverUrl ?? '',
  status: initial.status ?? ('draft' as const),
  body: initial.body ?? '',
};
---

<form
  class="editor-root"
  data-earth-editor
  data-earth-storage-key={resolvedKey}
  data-earth-storage-custom={storageKey ? 'true' : 'false'}
  data-earth-post-id={seed.id || 'new'}
  data-earth-site-domain={siteDomain}
>
  <ActionBar status={seed.status} />

  <div class="main-layout" data-earth-layout>
    <MetadataForm
      siteDomain={siteDomain}
      initial={{
        slug: seed.slug,
        excerpt: seed.excerpt,
        tags: seed.tags,
        font: seed.font,
        coverUrl: seed.coverUrl,
        status: seed.status === 'active' ? 'published' : 'draft',
      }}
    />

    <main class="editor-panel">
      <input
        type="text"
        class="title-input"
        data-earth-field="title"
        value={seed.title}
        placeholder="Title"
        maxlength="120"
        autocomplete="off"
        required
      />
      <ContentEditor initial={seed.body} coverUrl={seed.coverUrl} />
    </main>

    <AiPanel />
  </div>

  <input type="hidden" data-earth-field="id" value={seed.id} />
  <input type="hidden" data-earth-field="lang" value={seed.lang} />
</form>

<div class="save-indicator" data-earth-save-indicator hidden>
  <span data-earth-save-indicator-text>saved</span>
</div>

<!-- Ctrl+I: upload an image into the body -->
<div class="modal-overlay" data-earth-modal="image">
  <div class="modal modal--wide">
    <div class="upload-dropzone" data-earth-upload-dropzone>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="upload-icon"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      <div class="upload-text">Drop an image here, or <label class="upload-link" for="earth-body-image">browse</label></div>
      <div class="upload-limits">JPEG, PNG, WebP · uploaded straight to R2</div>
      <input type="file" id="earth-body-image" accept="image/jpeg,image/png,image/webp" hidden data-earth-body-image-file />
    </div>
    <div class="upload-error" data-earth-upload-error hidden></div>
    <div class="modal-hint">Press Esc to close</div>
  </div>
</div>

<!-- Ctrl+Shift+Y: embed a YouTube video -->
<div class="modal-overlay" data-earth-modal="video">
  <div class="modal">
    <h2 class="modal-title">Embed YouTube</h2>
    <input
      type="url"
      class="form-input"
      data-earth-video-url
      placeholder="https://youtube.com/watch?v=…"
      autocomplete="off"
    />
    <div class="upload-error" data-earth-video-error hidden></div>
    <div class="modal-actions">
      <button type="button" class="modal-btn modal-btn-cancel" data-earth-modal-close>Cancel</button>
      <button type="button" class="modal-btn modal-btn-confirm" data-earth-action="embed-video">Embed</button>
    </div>
    <div class="modal-hint">Paste a YouTube URL or an 11-character video id</div>
  </div>
</div>

<!-- Shown after a successful publish -->
<div class="modal-overlay" data-earth-modal="published">
  <div class="modal">
    <div class="publish-success-icon">✓</div>
    <h2 class="modal-title">Published</h2>
    <p class="modal-text">The post is live on the site right now.</p>
    <div class="publish-info">
      <div class="publish-row">
        <span class="publish-label">Title</span>
        <span class="publish-value" data-earth-published-title></span>
      </div>
      <div class="publish-row">
        <span class="publish-label">URL</span>
        <a class="publish-value publish-url" data-earth-published-url href="#" target="_blank" rel="noopener"></a>
      </div>
    </div>
    <div class="modal-actions modal-actions--stack">
      <a class="modal-btn modal-btn-confirm" data-earth-published-open href="#" target="_blank" rel="noopener">View post</a>
      <button type="button" class="modal-btn modal-btn-cancel" data-earth-action="copy-url">Copy link</button>
      <button type="button" class="modal-btn modal-btn-cancel" data-earth-modal-close>Keep editing</button>
    </div>
  </div>
</div>

<script>
  import { newCmsId, uploadAsset, attachPostAsset, getSettings, type PostDetail } from '../../lib/cms/client/api.ts';
  import {
    createPostEditorApi,
    PostEditorConflictError,
    PostEditorPublishError,
    type PostEditorDraft,
  } from '../../lib/cms/client/post-editor-api.ts';
  import { renderMarkdown } from '../../lib/cms/markdown/render.ts';

  const MAX_TAGS = 2;
  const EMOJI = [
    '✨', '✍️', '📝', '🎯', '🧭', '🗺️', '🧩', '📚', '💡', '🔍', '🧠', '⚡',
    '🌱', '🪴', '☕', '🌊', '🏔️', '🧵', '⏳', '🔁', '📊', '🛠️', '🚀', '🎧',
  ];

  /** ASCII-only, matching the server's slug pattern — Thai titles fall back to empty. */
  function autoSlug(title: string): string {
    return title
      .toLowerCase()
      .normalize('NFKD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 60)
      .replace(/-+$/g, '');
  }

  /** YouTube id from a full URL or a bare id; null when neither. */
  function youTubeId(input: string): string | null {
    const value = input.trim();
    if (/^[A-Za-z0-9_-]{11}$/.test(value)) return value;
    const match = value.match(
      /(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/|v\/|live\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/,
    );
    return match ? match[1] : null;
  }

  function initEditor(form: HTMLFormElement) {
    const api = createPostEditorApi();
    const siteDomain = form.dataset.earthSiteDomain || 'frong.me';
    let storageKey = form.dataset.earthStorageKey || 'earth:draft:new';
    const customStorageKey = form.dataset.earthStorageCustom === 'true';
    const initialPostId = form.dataset.earthPostId || 'new';
    let postId = initialPostId === 'new' ? newCmsId('post') : initialPostId;
    let currentPost: PostDetail | null = null;
    let pendingCoverAssetId: string | null = null;

    const field = <T extends HTMLElement>(name: string) =>
      form.querySelector<T>(`[data-earth-field="${name}"]`);

    const fields = {
      id: field<HTMLInputElement>('id'),
      lang: field<HTMLInputElement>('lang'),
      title: field<HTMLInputElement>('title'),
      slug: field<HTMLInputElement>('slug'),
      excerpt: field<HTMLTextAreaElement>('excerpt'),
      tags: field<HTMLInputElement>('tags'),
      font: field<HTMLSelectElement>('font'),
      coverUrl: field<HTMLInputElement>('coverUrl'),
      jsonLd: field<HTMLInputElement>('jsonLd'),
      status: field<HTMLInputElement>('status'),
      body: field<HTMLTextAreaElement>('body'),
    };

    let slugTouched = initialPostId !== 'new' || Boolean(fields.slug?.value);

    const saveStatus = form.querySelector<HTMLElement>('[data-earth-save-status]');
    const layout = form.querySelector<HTMLElement>('[data-earth-layout]');
    const scroll = form.querySelector<HTMLElement>('[data-earth-scroll]');
    const slugPreview = form.querySelector<HTMLElement>('[data-earth-slug-preview]');
    const slugMode = form.querySelector<HTMLElement>('[data-earth-slug-mode]');
    const jsonLdPreview = form.querySelector<HTMLElement>('[data-earth-jsonld-preview]');
    const coverContainer = form.querySelector<HTMLElement>('[data-earth-cover-container]');
    const coverPreview = form.querySelector<HTMLImageElement>('[data-earth-cover-preview]');
    const coverStatus = form.querySelector<HTMLElement>('[data-earth-cover-status]');
    const coverError = form.querySelector<HTMLElement>('[data-earth-cover-error]');
    const coverFileInput = form.querySelector<HTMLInputElement>('[data-earth-cover-file]');
    const coverZoomLabel = form.querySelector<HTMLElement>('[data-earth-cover-zoom-label]');
    const dropIndicator = form.querySelector<HTMLElement>('[data-earth-drop-indicator]');
    const emojiPicker = form.querySelector<HTMLElement>('[data-earth-emoji-picker]');
    const publishWrap = form.querySelector<HTMLElement>('[data-earth-publish-wrap]');
    const publishConfirm = form.querySelector<HTMLElement>('[data-earth-publish-confirm]');
    const unpublishWrap = form.querySelector<HTMLElement>('[data-earth-unpublish-wrap]');
    const unpublishConfirm = form.querySelector<HTMLElement>('[data-earth-unpublish-confirm]');
    const saveButton = form.querySelector<HTMLButtonElement>('[data-earth-action="save-draft"]');

    const counters = {
      words: form.querySelector<HTMLElement>('[data-earth-count="words"]'),
      chars: form.querySelector<HTMLElement>('[data-earth-count="chars"]'),
      title: form.querySelector<HTMLElement>('[data-earth-count="title"]'),
      excerpt: form.querySelector<HTMLElement>('[data-earth-count="excerpt"]'),
    };

    const saveIndicator = document.querySelector<HTMLElement>('[data-earth-save-indicator]');
    const saveIndicatorText = document.querySelector<HTMLElement>('[data-earth-save-indicator-text]');
    const modals = {
      image: document.querySelector<HTMLElement>('[data-earth-modal="image"]'),
      video: document.querySelector<HTMLElement>('[data-earth-modal="video"]'),
      published: document.querySelector<HTMLElement>('[data-earth-modal="published"]'),
    };
    const bodyImageInput = document.querySelector<HTMLInputElement>('[data-earth-body-image-file]');
    const uploadError = document.querySelector<HTMLElement>('[data-earth-upload-error]');
    const videoInput = document.querySelector<HTMLInputElement>('[data-earth-video-url]');
    const videoError = document.querySelector<HTMLElement>('[data-earth-video-error]');

    /* ---------------- Payload ---------------- */

    function buildPayload(statusOverride?: 'draft' | 'published'): PostEditorDraft {
      const tagsRaw = fields.tags?.value ?? '';
      return {
        id: postId,
        lang: fields.lang?.value === 'en' ? 'en' : 'th',
        title: fields.title?.value.trim() ?? '',
        slug: fields.slug?.value.trim() ?? '',
        excerpt: fields.excerpt?.value.trim() ?? '',
        tagIds: [...new Set(tagsRaw.split(',').map((tag) => tag.trim()).filter(Boolean))].slice(0, MAX_TAGS),
        status: statusOverride ?? (fields.status?.value === 'active' ? 'published' : 'draft'),
        bodyMarkdown: fields.body?.value ?? '',
        coverUrl: fields.coverUrl?.value.trim() ?? '',
        coverCrop: isDefaultCoverCrop(coverCrop) ? null : coverCrop,
      };
    }

    /* ---------------- Status + local backup ---------------- */

    let saveTimer: ReturnType<typeof setTimeout> | undefined;
    let indicatorTimer: ReturnType<typeof setTimeout> | undefined;
    let saving = false;
    let dirty = false;

    function setStatus(text: string, tone: 'idle' | 'saved' | 'offline' | 'error' = 'idle') {
      if (!saveStatus) return;
      saveStatus.textContent = text;
      saveStatus.className = `save-status${tone === 'idle' ? '' : ` ${tone}`}`;
    }

    function flashIndicator(text: string) {
      if (!saveIndicator || !saveIndicatorText) return;
      saveIndicatorText.textContent = text;
      saveIndicator.hidden = false;
      clearTimeout(indicatorTimer);
      indicatorTimer = setTimeout(() => { saveIndicator.hidden = true; }, 1800);
    }

    function readBackup(): PostEditorDraft | null {
      try {
        const raw = localStorage.getItem(storageKey);
        return raw ? (JSON.parse(raw) as PostEditorDraft) : null;
      } catch {
        return null;
      }
    }

    function writeBackup(payload: PostEditorDraft) {
      try {
        localStorage.setItem(storageKey, JSON.stringify({ ...payload, savedAt: Date.now() }));
      } catch {
        /* quota or private mode — the local backup is best-effort */
      }
    }

    function scheduleAutosave() {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        writeBackup(buildPayload());
        setStatus('Backed up locally', 'idle');
      }, 800);
    }

    function isPublished(): boolean {
      return fields.status?.value === 'active';
    }

    function setBusy(busy: boolean) {
      form.setAttribute('aria-busy', String(busy));
      form.querySelectorAll<HTMLButtonElement>('.header-btn').forEach((button) => {
        button.disabled = busy;
      });
    }

    function refreshPublishControls() {
      const published = isPublished();
      if (publishWrap) publishWrap.hidden = published;
      if (unpublishWrap) unpublishWrap.hidden = !published;
      if (publishConfirm) publishConfirm.classList.remove('active');
      if (unpublishConfirm) unpublishConfirm.classList.remove('active');
      // Save on an already-published post updates its live content in place
      // (no separate republish step) — label it accordingly so the button
      // doesn't read like it's stashing an unpublished draft.
      if (saveButton) {
        saveButton.textContent = published ? 'Update' : 'Save';
        saveButton.title = published ? 'Update the published post (Ctrl+S)' : 'Save draft (Ctrl+S)';
      }
    }

    /* ---------------- Derived UI ---------------- */

    function updateCounters() {
      const body = fields.body?.value ?? '';
      const words = body.trim().split(/\s+/).filter(Boolean).length;
      if (counters.words) counters.words.textContent = String(words);
      if (counters.chars) counters.chars.textContent = String(body.length);
      if (counters.title) {
        const length = fields.title?.value.length ?? 0;
        counters.title.textContent = String(length);
        counters.title.classList.toggle('over', length > 60);
      }
      if (counters.excerpt) {
        const length = fields.excerpt?.value.length ?? 0;
        counters.excerpt.textContent = String(length);
        counters.excerpt.classList.toggle('over', length > 160);
      }
    }

    function updateSlugPreview() {
      if (slugPreview) slugPreview.textContent = fields.slug?.value || 'your-slug';
    }

    function syncSlugFromTitle() {
      if (slugTouched || !fields.slug || !fields.title) return;
      const next = autoSlug(fields.title.value);
      if (next) fields.slug.value = next;
      updateSlugPreview();
    }

    function enforceTagLimit() {
      if (!fields.tags) return;
      const tags = fields.tags.value.split(',').map((tag) => tag.trim()).filter(Boolean);
      if (tags.length > MAX_TAGS) fields.tags.value = tags.slice(0, MAX_TAGS).join(', ');
    }

    function updateJsonLd() {
      if (!jsonLdPreview) return;
      if (!fields.jsonLd?.checked) {
        jsonLdPreview.hidden = true;
        return;
      }
      jsonLdPreview.textContent = JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: fields.title?.value ?? '',
        description: fields.excerpt?.value ?? '',
        image: fields.coverUrl?.value || undefined,
        datePublished: currentPost?.publishedAt
          ? new Date(currentPost.publishedAt).toISOString()
          : undefined,
      }, null, 2);
      jsonLdPreview.hidden = false;
    }

    function showCover(url: string) {
      if (!coverContainer || !coverPreview) return;
      if (url) {
        coverPreview.src = url;
        coverContainer.hidden = false;
      } else {
        coverPreview.removeAttribute('src');
        coverContainer.hidden = true;
      }
    }

    /* ---------------- Cover focal point + zoom ---------------- */

    const DEFAULT_COVER_CROP = { x: 50, y: 50, zoom: 1 };
    let coverCrop = { ...DEFAULT_COVER_CROP };

    function isDefaultCoverCrop(crop: typeof coverCrop): boolean {
      return crop.x === DEFAULT_COVER_CROP.x && crop.y === DEFAULT_COVER_CROP.y && crop.zoom === DEFAULT_COVER_CROP.zoom;
    }

    function applyCoverCropStyle() {
      if (!coverPreview) return;
      coverPreview.style.objectPosition = `${coverCrop.x}% ${coverCrop.y}%`;
      coverPreview.style.transform = `scale(${coverCrop.zoom})`;
      coverPreview.style.transformOrigin = `${coverCrop.x}% ${coverCrop.y}%`;
      if (coverZoomLabel) coverZoomLabel.textContent = `${coverCrop.zoom.toFixed(1)}x`;
    }

    /** Pass `null` for a freshly chosen image, where the old framing no longer applies. */
    function setCoverCrop(crop: typeof coverCrop | null) {
      coverCrop = crop ? { ...crop } : { ...DEFAULT_COVER_CROP };
      applyCoverCropStyle();
    }

    function adjustCoverZoom(delta: number) {
      const zoom = Math.min(3, Math.max(1, Math.round((coverCrop.zoom + delta) * 10) / 10));
      coverCrop = { ...coverCrop, zoom };
      applyCoverCropStyle();
      dirty = true;
      scheduleAutosave();
    }

    let coverDrag: { startX: number; startY: number; startCropX: number; startCropY: number } | null = null;

    coverPreview?.addEventListener('pointerdown', (event) => {
      if (!coverPreview.src) return;
      coverDrag = {
        startX: event.clientX,
        startY: event.clientY,
        startCropX: coverCrop.x,
        startCropY: coverCrop.y,
      };
      coverContainer?.setAttribute('data-earth-dragging', 'true');
      coverPreview.setPointerCapture(event.pointerId);
      event.preventDefault();
    });

    coverPreview?.addEventListener('pointermove', (event) => {
      if (!coverDrag || !coverContainer) return;
      const rect = coverContainer.getBoundingClientRect();
      // Dragging the photo right should reveal more of what's off-screen to
      // the left, so the focal point moves opposite to the pointer.
      const dxPct = ((event.clientX - coverDrag.startX) / rect.width) * 100;
      const dyPct = ((event.clientY - coverDrag.startY) / rect.height) * 100;
      coverCrop = {
        ...coverCrop,
        x: Math.min(100, Math.max(0, coverDrag.startCropX - dxPct)),
        y: Math.min(100, Math.max(0, coverDrag.startCropY - dyPct)),
      };
      applyCoverCropStyle();
    });

    function endCoverDrag() {
      if (!coverDrag) return;
      coverDrag = null;
      coverContainer?.removeAttribute('data-earth-dragging');
      dirty = true;
      scheduleAutosave();
    }

    coverPreview?.addEventListener('pointerup', endCoverDrag);
    coverPreview?.addEventListener('pointercancel', endCoverDrag);

    /** The body textarea grows with its content so `.editor-scroll` is the only scroller. */
    function autoGrow() {
      const textarea = fields.body;
      if (!textarea || !scroll) return;
      const top = scroll.scrollTop;
      textarea.style.height = 'auto';
      textarea.style.height = `${textarea.scrollHeight}px`;
      scroll.scrollTop = top;
    }

    /* ---------------- Uploads ---------------- */

    function setCoverError(message: string) {
      if (!coverError) return;
      coverError.textContent = message;
      coverError.hidden = !message;
    }

    async function handleCoverFile(file: File) {
      setCoverError('');
      if (coverStatus) coverStatus.textContent = 'Uploading…';
      try {
        const uploaded = await uploadAsset(file, 'photo');
        pendingCoverAssetId = uploaded.id;
        if (fields.coverUrl) fields.coverUrl.value = uploaded.url;
        showCover(uploaded.url);
        setCoverCrop(null);
        updateJsonLd();
        scheduleAutosave();
        dirty = true;
        if (coverStatus) coverStatus.textContent = 'Attaches on next save';
      } catch (error) {
        if (coverStatus) coverStatus.textContent = '';
        setCoverError((error as Error).message);
      }
    }

    async function handleBodyImage(file: File) {
      if (!fields.body) return;
      if (uploadError) uploadError.hidden = true;
      try {
        const uploaded = await uploadAsset(file, 'photo');
        const alt = file.name.replace(/\.[^.]+$/, '') || 'image';
        insertAtCursor(`\n![${alt}](${uploaded.url})\n`);
        closeModal(modals.image);
        flashIndicator('image inserted');
      } catch (error) {
        if (uploadError) {
          uploadError.textContent = (error as Error).message;
          uploadError.hidden = false;
        }
      }
    }

    /** Links an uploaded cover to the post so the reader route resolves it from R2. */
    async function attachPendingCover() {
      if (!pendingCoverAssetId || !currentPost) return;
      try {
        const result = await attachPostAsset(postId, {
          id: newCmsId('usage'),
          assetId: pendingCoverAssetId,
          role: 'cover',
          altText: fields.title?.value.trim() || 'Cover image',
          expectedDraftVersion: currentPost.draftVersion,
        });
        if (result.ok) {
          currentPost = result.data;
          pendingCoverAssetId = null;
          if (coverStatus) coverStatus.textContent = 'Attached';
        }
      } catch {
        // Non-fatal: the post itself saved, and the cover URL is already
        // stored on it. The attach retries on the next save.
      }
    }

    /* ---------------- Text insertion ---------------- */

    function insertAtCursor(text: string) {
      const textarea = fields.body;
      if (!textarea) return;
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      textarea.value = textarea.value.slice(0, start) + text + textarea.value.slice(end);
      const caret = start + text.length;
      textarea.setSelectionRange(caret, caret);
      textarea.focus();
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
    }

    function wrapSelection(marker: string, placeholder: string) {
      const textarea = fields.body;
      if (!textarea) return;
      const { selectionStart: start, selectionEnd: end, value } = textarea;
      const selected = value.slice(start, end) || placeholder;
      textarea.value = value.slice(0, start) + marker + selected + marker + value.slice(end);
      textarea.setSelectionRange(start + marker.length, start + marker.length + selected.length);
      textarea.focus();
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
    }

    /* ---------------- Modals ---------------- */

    function openModal(modal: HTMLElement | null) {
      modal?.setAttribute('data-visible', 'true');
    }

    function closeModal(modal: HTMLElement | null) {
      modal?.removeAttribute('data-visible');
    }

    function closeAllModals() {
      Object.values(modals).forEach(closeModal);
      if (emojiPicker) emojiPicker.hidden = true;
    }

    function toggleEmojiPicker() {
      if (!emojiPicker) return;
      if (!emojiPicker.hidden) {
        emojiPicker.hidden = true;
        return;
      }
      if (emojiPicker.childElementCount === 0) {
        for (const emoji of EMOJI) {
          const item = document.createElement('button');
          item.type = 'button';
          item.className = 'emoji-item';
          item.textContent = emoji;
          item.addEventListener('click', () => {
            insertAtCursor(emoji);
            emojiPicker.hidden = true;
          });
          emojiPicker.append(item);
        }
      }
      emojiPicker.hidden = false;
    }

    /* ---------------- Persistence ---------------- */

    function applyPost(post: PostDetail) {
      postId = post.id;
      form.dataset.earthPostId = post.id;
      if (fields.id) fields.id.value = post.id;
      if (fields.lang) fields.lang.value = post.lang;
      if (fields.title) fields.title.value = post.title;
      if (fields.slug) fields.slug.value = post.slug;
      if (fields.excerpt) fields.excerpt.value = post.excerpt ?? '';
      if (fields.tags) fields.tags.value = post.tagNames.slice(0, MAX_TAGS).join(', ');
      if (fields.body) fields.body.value = post.bodyMarkdown;
      if (fields.status) fields.status.value = post.lifecycle === 'active' ? 'active' : 'draft';
      if (fields.coverUrl) fields.coverUrl.value = post.coverImageUrl ?? '';
      showCover(fields.coverUrl?.value ?? '');
      setCoverCrop(post.coverCrop);
      slugTouched = true;
      if (slugMode) slugMode.textContent = 'manual';
      currentPost = post;
      refreshPublishControls();
    }

    function restoreBackup() {
      const backup = readBackup();
      if (!backup) return;
      if (initialPostId === 'new' && backup.id) {
        postId = backup.id;
        form.dataset.earthPostId = postId;
      } else if (backup.id && backup.id !== postId) {
        return;
      }
      if (fields.lang) fields.lang.value = backup.lang;
      if (fields.id) fields.id.value = postId;
      if (fields.title) fields.title.value = backup.title;
      if (fields.slug) fields.slug.value = backup.slug;
      if (fields.excerpt) fields.excerpt.value = backup.excerpt;
      if (fields.tags && Array.isArray(backup.tagIds)) {
        fields.tags.value = backup.tagIds.slice(0, MAX_TAGS).join(', ');
      }
      if (fields.body) fields.body.value = backup.bodyMarkdown;
      if (fields.coverUrl && backup.coverUrl) fields.coverUrl.value = backup.coverUrl;
      showCover(fields.coverUrl?.value ?? '');
      setCoverCrop(backup.coverCrop ?? null);
      dirty = true;
      setStatus('Restored a local draft', 'offline');
    }

    async function persist(statusOverride: 'draft' | 'published') {
      const payload = buildPayload(statusOverride);
      if (!payload.title) {
        setStatus('Title is required', 'error');
        fields.title?.focus();
        return;
      }
      if (!payload.slug) {
        setStatus('Slug is required', 'error');
        fields.slug?.focus();
        return;
      }
      if (saving) return;
      clearTimeout(saveTimer);
      saving = true;
      setBusy(true);
      const wasPublished = currentPost?.lifecycle === 'active';
      setStatus(statusOverride === 'published' ? 'Publishing…' : wasPublished ? 'Updating…' : 'Saving…');
      try {
        const previousStorageKey = storageKey;
        const result = statusOverride === 'published'
          ? await api.publish(payload, currentPost)
          : { post: await api.save(payload, currentPost) };
        currentPost = result.post;
        postId = result.post.id;
        form.dataset.earthPostId = postId;
        if (fields.id) fields.id.value = postId;
        if (!customStorageKey) storageKey = `earth:draft:${postId}`;
        await attachPendingCover();
        localStorage.removeItem(previousStorageKey);
        localStorage.removeItem(storageKey);
        dirty = false;
        // Read the lifecycle back from the row the server actually returned,
        // not from which button was clicked: a plain Save on an already-
        // published post updates its live content in place and leaves it
        // published (the public routes read `posts` directly, so no republish
        // step is needed) — inferring 'draft' here from statusOverride alone
        // would wrongly flip the buttons back to "Publish" after every such
        // save, inviting a publish attempt that only 409s.
        if (fields.status) fields.status.value = result.post.lifecycle === 'active' ? 'active' : 'draft';
        refreshPublishControls();
        const nowPublished = result.post.lifecycle === 'active';
        setStatus(nowPublished && statusOverride !== 'published' ? 'Updated' : 'Saved', 'saved');
        flashIndicator(`${nowPublished && statusOverride !== 'published' ? 'updated' : 'saved'} ${new Date().toLocaleTimeString(undefined, { hour12: false })}`);
        if (statusOverride === 'published') showPublished(result.post);
      } catch (error) {
        // A 409 reports the server's real current version. Advancing our copy
        // to match means the *next* explicit save the user triggers succeeds
        // instead of conflicting forever on the same stale number — we do not
        // resend automatically, so this never silently overwrites a genuine
        // concurrent edit without the user taking another explicit action.
        if (error instanceof PostEditorPublishError) currentPost = error.post;
        const conflictVersion = error instanceof PostEditorConflictError
          ? error.currentDraftVersion
          : error instanceof PostEditorPublishError
            ? error.currentDraftVersion
            : undefined;
        const conflictLifecycle = error instanceof PostEditorConflictError
          ? error.currentLifecycle
          : error instanceof PostEditorPublishError
            ? error.currentLifecycle
            : undefined;
        let suffix = '';
        if (conflictVersion !== undefined && currentPost) {
          currentPost = { ...currentPost, draftVersion: conflictVersion };
          if (conflictLifecycle !== undefined && conflictLifecycle !== 'draft') {
            // publishPost only matches lifecycle = 'draft' — this row already
            // is/was published or archived, so no retry at any version fixes
            // it. Sync the button state to match instead of inviting another
            // click that fails the same way.
            currentPost = { ...currentPost, lifecycle: conflictLifecycle };
            if (fields.status) fields.status.value = conflictLifecycle === 'active' ? 'active' : 'draft';
            refreshPublishControls();
            suffix = conflictLifecycle === 'active'
              ? ' — it is already published, not resaved'
              : ' — it is archived, not resaved';
          } else {
            suffix = ' — version refreshed, try again';
          }
        }
        writeBackup(payload);
        dirty = true;
        setStatus(`Save failed: ${(error as Error).message}${suffix}`, 'error');
      } finally {
        saving = false;
        setBusy(false);
      }
    }

    async function unpublish() {
      if (!currentPost) return;
      saving = true;
      setBusy(true);
      setStatus('Unpublishing…');
      try {
        currentPost = await api.unpublish(currentPost);
        if (fields.status) fields.status.value = 'draft';
        refreshPublishControls();
        setStatus('Back to draft', 'saved');
      } catch (error) {
        let suffix = '';
        if (error instanceof PostEditorConflictError && error.currentDraftVersion !== undefined && currentPost) {
          currentPost = { ...currentPost, draftVersion: error.currentDraftVersion };
          const { currentLifecycle } = error;
          if (currentLifecycle !== undefined && currentLifecycle !== 'active') {
            // unpublishPost only matches lifecycle = 'active' — this row
            // already is/was a draft or archived, so no retry fixes it.
            currentPost = { ...currentPost, lifecycle: currentLifecycle };
            if (fields.status) fields.status.value = currentLifecycle === 'active' ? 'active' : 'draft';
            refreshPublishControls();
            suffix = currentLifecycle === 'draft'
              ? ' — it is already a draft'
              : ' — it is archived';
          } else {
            suffix = ' — version refreshed, try again';
          }
        }
        setStatus(`Unpublish failed: ${(error as Error).message}${suffix}`, 'error');
      } finally {
        saving = false;
        setBusy(false);
      }
    }

    function showPublished(post: PostDetail) {
      const path = `/articles/${post.slug}`;
      const url = new URL(path, window.location.origin).href;
      const titleEl = document.querySelector<HTMLElement>('[data-earth-published-title]');
      const urlEl = document.querySelector<HTMLAnchorElement>('[data-earth-published-url]');
      const openEl = document.querySelector<HTMLAnchorElement>('[data-earth-published-open]');
      if (titleEl) titleEl.textContent = post.title;
      if (urlEl) {
        urlEl.textContent = `${siteDomain}${path}`;
        urlEl.href = path;
      }
      if (openEl) openEl.href = path;
      openModal(modals.published);
    }

    /* ---------------- Preview in a new tab ---------------- */

    function openPreview() {
      const { html } = renderMarkdown(fields.body?.value ?? '');
      const payload = {
        title: fields.title?.value || 'Untitled',
        excerpt: fields.excerpt?.value ?? '',
        cover: fields.coverUrl?.value ?? '',
        coverCrop: isDefaultCoverCrop(coverCrop) ? null : coverCrop,
        tags: (fields.tags?.value ?? '').split(',').map((tag) => tag.trim()).filter(Boolean),
        font: fields.font?.value || 'google-sans',
        articleHtml: html,
      };

      // A blob: URL document breaks YouTube's embedded player (Error 153),
      // and writing the page via document.write into a window.open('', ...)
      // popup proved unreliable across real browsers (some leave the tab
      // blank). Handing the draft to a real, same-origin page instead avoids
      // both: sessionStorage is shared with same-origin auxiliary tabs as
      // long as `noopener` isn't used, so /earth/preview reads it back and
      // renders it itself through an ordinary navigation.
      sessionStorage.setItem('earth:preview', JSON.stringify(payload));
      window.open('/earth/preview', 'earth-preview');
    }

    /* ---------------- Zen mode ---------------- */

    let zenActive = false;
    function toggleZen(force?: boolean) {
      zenActive = force ?? !zenActive;
      layout?.setAttribute('data-earth-zen', String(zenActive));
      document.body.classList.toggle('zen-mode', zenActive);
    }

    /* ---------------- Events ---------------- */

    form.addEventListener('input', (event) => {
      dirty = true;
      const target = event.target as HTMLElement;
      if (target === fields.title) syncSlugFromTitle();
      if (target === fields.slug) {
        slugTouched = true;
        if (slugMode) slugMode.textContent = 'manual';
        updateSlugPreview();
      }
      if (target === fields.tags) enforceTagLimit();
      if (target === fields.coverUrl) {
        showCover(fields.coverUrl?.value ?? '');
        setCoverCrop(null);
      }
      if (target === fields.body) autoGrow();
      updateCounters();
      updateJsonLd();
      scheduleAutosave();
    });

    form.addEventListener('change', (event) => {
      const target = event.target as HTMLElement;
      if (target === fields.jsonLd) updateJsonLd();
      scheduleAutosave();
    });

    form.addEventListener('submit', (event) => event.preventDefault());

    form.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-earth-action]');
      if (!trigger) return;
      const action = trigger.dataset.earthAction;

      switch (action) {
        case 'save-draft':
          void persist('draft');
          break;
        case 'preview':
          openPreview();
          break;
        case 'publish-toggle':
          publishConfirm?.classList.add('active');
          break;
        case 'publish-confirm':
          publishConfirm?.classList.remove('active');
          void persist('published');
          break;
        case 'publish-cancel':
          publishConfirm?.classList.remove('active');
          break;
        case 'unpublish-toggle':
          unpublishConfirm?.classList.add('active');
          break;
        case 'unpublish-confirm':
          unpublishConfirm?.classList.remove('active');
          void unpublish();
          break;
        case 'unpublish-cancel':
          unpublishConfirm?.classList.remove('active');
          break;
        case 'pick-cover':
          coverFileInput?.click();
          break;
        case 'clear-cover':
          if (fields.coverUrl) fields.coverUrl.value = '';
          pendingCoverAssetId = null;
          if (coverStatus) coverStatus.textContent = '';
          showCover('');
          setCoverCrop(null);
          updateJsonLd();
          scheduleAutosave();
          dirty = true;
          break;
        case 'cover-zoom-in':
          adjustCoverZoom(0.1);
          break;
        case 'cover-zoom-out':
          adjustCoverZoom(-0.1);
          break;
        case 'cover-reset-position':
          setCoverCrop(null);
          dirty = true;
          scheduleAutosave();
          break;
        case 'toggle-help':
        case 'toggle-shortcuts': {
          const isHelp = action === 'toggle-help';
          const content = form.querySelector<HTMLElement>(
            isHelp ? '[data-earth-help-content]' : '[data-earth-shortcuts-content]',
          );
          const icon = form.querySelector<HTMLElement>(
            isHelp ? '[data-earth-help-icon]' : '[data-earth-shortcuts-icon]',
          );
          if (!content) break;
          content.hidden = !content.hidden;
          trigger.setAttribute('aria-expanded', String(!content.hidden));
          if (icon) icon.textContent = content.hidden ? '+' : '−';
          break;
        }
      }
    });

    coverFileInput?.addEventListener('change', () => {
      const file = coverFileInput.files?.[0];
      if (file) void handleCoverFile(file);
      coverFileInput.value = '';
    });

    bodyImageInput?.addEventListener('change', () => {
      const file = bodyImageInput.files?.[0];
      if (file) void handleBodyImage(file);
      bodyImageInput.value = '';
    });

    /* Drag and drop straight onto the writing surface */
    const dropZone = form.querySelector<HTMLElement>('[data-earth-image-drop]');
    dropZone?.addEventListener('dragover', (event) => {
      event.preventDefault();
      if (dropIndicator) dropIndicator.hidden = false;
    });
    dropZone?.addEventListener('dragleave', () => {
      if (dropIndicator) dropIndicator.hidden = true;
    });
    dropZone?.addEventListener('drop', (event) => {
      event.preventDefault();
      if (dropIndicator) dropIndicator.hidden = true;
      const file = event.dataTransfer?.files?.[0];
      if (file?.type.startsWith('image/')) void handleBodyImage(file);
    });

    const uploadDropzone = document.querySelector<HTMLElement>('[data-earth-upload-dropzone]');
    uploadDropzone?.addEventListener('dragover', (event) => {
      event.preventDefault();
      uploadDropzone.setAttribute('data-dragover', 'true');
    });
    uploadDropzone?.addEventListener('dragleave', () => uploadDropzone.removeAttribute('data-dragover'));
    uploadDropzone?.addEventListener('drop', (event) => {
      event.preventDefault();
      uploadDropzone.removeAttribute('data-dragover');
      const file = event.dataTransfer?.files?.[0];
      if (file?.type.startsWith('image/')) void handleBodyImage(file);
    });

    /* Modal chrome */
    document.querySelectorAll<HTMLElement>('[data-earth-modal]').forEach((modal) => {
      modal.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target === modal || target.closest('[data-earth-modal-close]')) closeModal(modal);

        const action = target.closest<HTMLElement>('[data-earth-action]')?.dataset.earthAction;
        if (action === 'embed-video') {
          const id = youTubeId(videoInput?.value ?? '');
          if (!id) {
            if (videoError) {
              videoError.textContent = 'That is not a YouTube URL or video id.';
              videoError.hidden = false;
            }
            return;
          }
          insertAtCursor(`\n\n@[youtube](${id})\n\n`);
          closeModal(modals.video);
        }
        if (action === 'copy-url') {
          const link = document.querySelector<HTMLAnchorElement>('[data-earth-published-url]');
          if (link) void navigator.clipboard.writeText(new URL(link.getAttribute('href') ?? '/', window.location.origin).href);
          const button = target.closest<HTMLButtonElement>('[data-earth-action="copy-url"]');
          if (button) {
            button.textContent = 'Copied';
            setTimeout(() => { button.textContent = 'Copy link'; }, 1500);
          }
        }
      });
    });

    /* Shortcuts */
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeAllModals();
        return;
      }
      if (!(event.ctrlKey || event.metaKey)) return;
      const key = event.key.toLowerCase();

      if (key === 's') {
        event.preventDefault();
        void persist('draft');
      } else if (key === 'p') {
        event.preventDefault();
        openPreview();
      } else if (key === 'b' && document.activeElement === fields.body) {
        event.preventDefault();
        wrapSelection('**', 'bold text');
      } else if (key === 'e') {
        event.preventDefault();
        toggleEmojiPicker();
      } else if (key === 'i') {
        event.preventDefault();
        if (uploadError) uploadError.hidden = true;
        openModal(modals.image);
      } else if (key === 'y' && event.shiftKey) {
        event.preventDefault();
        if (videoError) videoError.hidden = true;
        if (videoInput) videoInput.value = '';
        openModal(modals.video);
        setTimeout(() => videoInput?.focus(), 50);
      } else if (key === 'm') {
        event.preventDefault();
        window.location.href = '/earth';
      } else if (key === '/') {
        event.preventDefault();
        toggleZen();
      }
    });

    window.addEventListener('beforeunload', () => {
      if (dirty || saving) writeBackup(buildPayload());
    });

    /* ---------------- Boot ---------------- */

    async function boot() {
      if (initialPostId !== 'new') {
        setBusy(true);
        setStatus('Loading…');
        try {
          applyPost(await api.fetch(initialPostId));
          setStatus('Loaded', 'saved');
        } catch (error) {
          setStatus(`Load failed — local draft kept: ${(error as Error).message}`, 'error');
        } finally {
          setBusy(false);
        }
      } else {
        // Only a starting point for a brand-new post — never overrides an
        // existing post's own choice, and a restored local backup (below)
        // still wins if the user already picked something this session.
        try {
          const settings = await getSettings();
          if (fields.font) fields.font.value = settings.defaultFont;
          const providerSelect = document.querySelector<HTMLSelectElement>('[data-earth-ai-provider]');
          if (providerSelect) providerSelect.value = settings.defaultAiProvider;
        } catch {
          // Non-fatal: the hardcoded defaults already rendered server-side.
        }
      }
      restoreBackup();
      updateCounters();
      updateSlugPreview();
      updateJsonLd();
      refreshPublishControls();
      showCover(fields.coverUrl?.value ?? '');
      autoGrow();
    }

    void boot();
  }

  document.querySelectorAll<HTMLFormElement>('[data-earth-editor]').forEach(initEditor);
</script>
