---
interface Props {
  measurementId?: string;
  language?: 'th' | 'en';
}

const measurementId = Astro.props.measurementId?.trim();
const enabled = Boolean(measurementId && /^G-[A-Z0-9]+$/.test(measurementId));
const language = Astro.props.language === 'th' ? 'th' : 'en';
const copy = language === 'th'
  ? {
      title: 'ช่วยเราปรับปรุงเว็บไซต์',
      description: 'เราใช้ Google Analytics เพื่อวัดการเข้าชมและปรับปรุงเว็บไซต์ โดยจะไม่เปิดใช้งานจนกว่าคุณจะยินยอม',
      deny: 'ปฏิเสธ',
      accept: 'อนุญาต',
      privacy: 'อ่านรายละเอียดความเป็นส่วนตัว',
      granted: 'สถานะปัจจุบัน: อนุญาตข้อมูลวิเคราะห์',
      denied: 'สถานะปัจจุบัน: ปฏิเสธข้อมูลวิเคราะห์',
    }
  : {
      title: 'Help improve this site',
      description: 'We use Google Analytics to measure visits and improve this site. It stays off until you allow it.',
      deny: 'Decline',
      accept: 'Allow',
      privacy: 'Read the privacy details',
      granted: 'Current choice: analytics allowed',
      denied: 'Current choice: analytics declined',
    };
---

{enabled && (
  <div
    class="analytics-root"
    data-analytics-root
    data-measurement-id={measurementId}
    data-status-granted={copy.granted}
    data-status-denied={copy.denied}
  >
    <aside
      class="analytics-consent"
      data-analytics-consent
      hidden
      aria-live="polite"
      aria-labelledby="analytics-consent-title"
      aria-describedby="analytics-consent-description"
    >
      <h2 id="analytics-consent-title">{copy.title}</h2>
      <p id="analytics-consent-description">{copy.description}</p>
      <p class="analytics-status" data-analytics-status hidden></p>
      <a class="analytics-privacy" href="/privacy/">{copy.privacy}</a>
      <div class="analytics-actions">
        <button type="button" data-analytics-deny>{copy.deny}</button>
        <button type="button" data-analytics-accept>{copy.accept}</button>
      </div>
    </aside>
  </div>
)}

<script>
  import { mountAnalyticsConsent } from '../lib/analytics-consent.ts';

  document.querySelectorAll<HTMLElement>('[data-analytics-root]')
    .forEach((root) => mountAnalyticsConsent(root));
</script>

<style>
  .analytics-consent {
    position: fixed;
    z-index: 100;
    right: 1rem;
    bottom: 1rem;
    width: min(24rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    box-shadow: 0 12px 36px rgb(0 0 0 / 0.14);
    font: 400 0.875rem/1.5 Inter, system-ui, sans-serif;
  }
  .analytics-consent h2 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 600;
  }
  .analytics-consent p {
    margin: 0;
  }
  .analytics-status {
    margin-top: 0.55rem !important;
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
  }
  .analytics-privacy {
    display: inline-block;
    margin-top: 0.55rem;
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .analytics-actions {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .analytics-consent button {
    border: 1px solid hsl(var(--border));
    border-radius: 9999px;
    padding: 0.45rem 0.75rem;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    cursor: pointer;
  }
  .analytics-consent button {
    flex: 1;
    min-height: 2.25rem;
    font-weight: 500;
  }
  .analytics-consent button:hover {
    background: hsl(var(--accent));
  }
  .analytics-consent button:focus-visible,
  .analytics-privacy:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
  }
  @supports (padding: env(safe-area-inset-bottom)) {
    .analytics-consent {
      bottom: max(1rem, env(safe-area-inset-bottom));
    }
  }
  @media (max-width: 40rem) {
    .analytics-consent {
      bottom: calc(5.25rem + env(safe-area-inset-bottom, 0px));
    }
  }
  [hidden] { display: none !important; }
</style>
