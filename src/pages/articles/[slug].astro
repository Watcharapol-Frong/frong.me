---
/**
 * Article detail: direct-SSR reader route. No `getStaticPaths` — a
 * prerendered dynamic route cannot reliably reach the D1 binding at build
 * time (the separate build-time prerender worker; see astro/astro#16553),
 * and edge caching below only makes sense for an on-demand route anyway.
 */
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar";
import FloatingNav from "@/components/FloatingNav";
import TableOfContents from "@/components/TableOfContents.astro";
import ShareButton from "@/components/ShareButton";
import { resolveCmsDatabase } from "@/server/cms/api.ts";
import {
  getPublishedPostBySlug,
  listPublishedPosts,
  listPublicPostAssets,
} from "@/server/cms/repositories/public.ts";
import { getPostTaxonomy, listPostSources } from "@/server/cms/repositories/taxonomy.ts";
import { publicAssetUrl } from "@/lib/cms/markdown/asset-resolver.ts";
import { renderMarkdown } from "@/lib/cms/markdown/render.ts";

export const prerender = false;

const { slug } = Astro.params;

const db = await resolveCmsDatabase(Astro.locals);
const post = slug ? await getPublishedPostBySlug(db, slug) : null;

if (!post) {
  return new Response(null, { status: 404 });
}

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=3600, stale-while-revalidate=86400",
);

const [assets, taxonomy, sources, otherPosts] = await Promise.all([
  listPublicPostAssets(db, post.id),
  getPostTaxonomy(db, post.id),
  listPostSources(db, post.id),
  listPublishedPosts(db, { limit: 60 }),
]);

const cover = assets.find((asset) => asset.role === "cover");
const coverUrl = cover
  ? publicAssetUrl(cover, "https://images.frong.me")
  : post.cover_image_url ?? undefined;

// Focal point + zoom set by dragging/zooming the cover in the Earth editor.
// Tolerant on purpose: malformed stored JSON should fall back to a plain,
// uncropped cover rather than 500 the page for a reader.
function parseCoverCrop(value: string | null): { x: number; y: number; zoom: number } | null {
  if (!value) return null;
  try {
    const parsed = JSON.parse(value);
    if (
      parsed && typeof parsed === "object"
      && typeof parsed.x === "number" && typeof parsed.y === "number" && typeof parsed.zoom === "number"
    ) {
      return { x: parsed.x, y: parsed.y, zoom: parsed.zoom };
    }
  } catch {
    // fall through to null
  }
  return null;
}

const coverCrop = parseCoverCrop(post.cover_crop);
const coverStyle = coverCrop
  ? `object-position: ${coverCrop.x}% ${coverCrop.y}%; transform: scale(${coverCrop.zoom}); transform-origin: ${coverCrop.x}% ${coverCrop.y}%;`
  : undefined;
const tags = taxonomy.tags.map((tag) => tag.slug);

const { html: bodyHtml, headings } = renderMarkdown(post.body_markdown);

const otherArticles = otherPosts.filter((candidate) => candidate.id !== post.id);
const scored = await Promise.all(
  otherArticles.map(async (candidate) => {
    const candidateTaxonomy = await getPostTaxonomy(db, candidate.id);
    const overlap = candidateTaxonomy.tags.filter((tag) => tags.includes(tag.slug)).length;
    return { post: candidate, overlap };
  }),
);
const relatedArticles = scored
  .sort((a, b) => b.overlap - a.overlap || b.post.updated_at - a.post.updated_at)
  .slice(0, 3)
  .map((entry) => entry.post);

const publishedAtIso = new Date(post.published_at ?? post.created_at).toISOString();
---

<Layout title={`${post.title} - frong.me`} description={post.excerpt ?? undefined} ogImage={coverUrl}>
  <main class="min-h-screen bg-background page-transition">
    <Navbar client:load />

    <section class="pt-28 pb-8 px-6">
      <div class="max-w-2xl mx-auto">
        {coverUrl && (
          <div class="w-full aspect-[1.91/1] overflow-hidden rounded-[10px] bg-muted mb-14 fade-in-up">
            <img src={coverUrl} alt={post.title} class="w-full h-full object-cover" style={coverStyle} />
          </div>
        )}

        <div class="mb-8 fade-in-up fade-in-up-delay-1">
          <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
            <p class="text-sm text-muted-foreground">
              {new Date(publishedAtIso).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              {tags.length > 0 && " · "}
              {tags.map((tag, i) => (
                <>
                  {i > 0 && " "}
                  <a
                    href={`/?tag=${encodeURIComponent(tag)}`}
                    class="hover:text-foreground hover:underline transition-colors"
                  >
                    #{tag}
                  </a>
                </>
              ))}
            </p>
            <ShareButton title={post.title} client:load />
          </div>
          <h1 class="text-article-title font-bold mb-3 font-sans">{post.title}</h1>
          {post.excerpt && (
            <p class="text-lg text-muted-foreground">{post.excerpt}</p>
          )}
        </div>

        <TableOfContents headings={headings} />

        <article
          class="prose prose-neutral dark:prose-invert max-w-none
            prose-pre:bg-muted prose-pre:text-foreground prose-pre:border prose-pre:border-border prose-pre:rounded-lg prose-pre:shadow-none
            prose-img:rounded-[10px]"
          set:html={bodyHtml}
        />

        {sources.length > 0 && (
          <section class="mt-12 pt-8 border-t border-border">
            <h2 class="text-xs uppercase tracking-widest text-muted-foreground mb-4">
              Sources
            </h2>
            <ul class="space-y-2">
              {sources.map((source) => (
                <li>
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm underline hover:opacity-70 transition-opacity"
                  >
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {relatedArticles.length > 0 && (
          <section class="mt-12 pt-8 border-t border-border">
            <h2 class="text-xs uppercase tracking-widest text-muted-foreground mb-4">
              Related articles
            </h2>
            <ul class="space-y-2">
              {relatedArticles.map((related) => (
                <li>
                  <a
                    href={`/articles/${related.slug}`}
                    class="text-sm underline hover:opacity-70 transition-opacity"
                  >
                    {related.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </section>
  </main>
  <FloatingNav client:load />
</Layout>
