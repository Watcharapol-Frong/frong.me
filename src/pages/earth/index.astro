---
/**
 * Earth admin portal.
 *
 * Deliberately not built on `Layout.astro`: that layout is the public site's
 * chrome (site nav, canonical URL, OG/Twitter metadata, sitemap-facing markup),
 * none of which belongs on an authenticated tool.
 *
 * This page ships **no data**. Every value the portal shows is fetched in the
 * browser from `/earth/api/*` through `src/lib/cms/client/api.ts` — nothing
 * private is baked into a prerendered file, and the page stays on-demand so
 * every request crosses the Access-verifying middleware (S-02). The `noindex`
 * tag below is defence in depth for the window where the route is served as
 * a static asset.
 */
import Portal from '../../components/earth/Portal.astro';

export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="same-origin" />
    <title>Portal · FRONG.ME</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=Google+Sans:wght@400;500;600&display=swap"
    />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      * { margin: 0; padding: 0; }

      html, body { height: 100%; }

      body {
        background: #fff;
        color: #000;
        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        overflow: hidden;
        animation: earth-fade-in 0.8s ease-out forwards;
      }

      @keyframes earth-fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      ::-webkit-scrollbar { width: 6px; height: 6px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: #ddd; border-radius: 3px; }
      ::-webkit-scrollbar-thumb:hover { background: #ccc; }
      * { scrollbar-width: thin; scrollbar-color: #ddd transparent; }

      ::selection { background: #e5e5e5; color: #000; }

      @media (max-width: 1000px) {
        html, body { height: auto; overflow: auto; }
      }
    </style>
  </head>

  <body>
    <Portal />

    <noscript>
      <div style="padding:1.5rem;font-size:0.875rem;">
        <p style="font-weight:600;">JavaScript is required</p>
        <p style="margin-top:0.5rem;opacity:0.7;">
          The admin portal reads and writes through the authenticated
          <code>/earth/api</code> endpoints. Public article pages remain
          readable without JavaScript.
        </p>
      </div>
    </noscript>
  </body>
</html>
