---
/**
 * Earth admin portal.
 *
 * Deliberately not built on `Layout.astro`: that layout is the public site's
 * chrome (site nav, canonical URL, OG/Twitter metadata, sitemap-facing markup),
 * none of which belongs on an authenticated tool.
 *
 * This page ships **no data**. Every value the portal shows is fetched in the
 * browser from `/earth/api/*` through `src/lib/cms/client/api.ts` — nothing
 * private is baked into a prerendered file, and the page stays on-demand so
 * every request crosses the Access-verifying middleware (S-02). The `noindex`
 * tag below is defence in depth for the window where the route is served as
 * a static asset.
 */
import Portal from '../../components/earth/Portal.astro';

export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="same-origin" />
    <title>Earth · frong.me</title>
    <style>
      :root {
        --earth-accent: #6d5bd0;
        --earth-accent-contrast: #ffffff;
        --earth-border: rgba(128, 128, 128, 0.3);
        color-scheme: light dark;
      }
      body {
        margin: 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: #fafafa;
        color: #1a1a1a;
      }
      @media (prefers-color-scheme: dark) {
        body { background: #141414; color: #ededed; }
      }
    </style>
  </head>

  <body>
    <Portal />

    <noscript>
      <div style="padding:1.5rem;font-size:0.875rem;">
        <p style="font-weight:600;">JavaScript is required</p>
        <p style="margin-top:0.5rem;opacity:0.7;">
          The admin portal reads and writes through the authenticated
          <code>/earth/api</code> endpoints. Public article pages remain
          readable without JavaScript.
        </p>
      </div>
    </noscript>
  </body>
</html>
