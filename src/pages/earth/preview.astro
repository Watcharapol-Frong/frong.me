---
/**
 * Renders the editor's "Preview" tab.
 *
 * The editor used to build this whole page as an HTML string and hand it to
 * the popup via a `blob:` URL, then via `document.write` after that broke
 * YouTube's embedded player (Error 153). Both routes proved unreliable
 * (`document.write` into a window opened with an empty URL is flaky across
 * real browsers — some leave the tab blank). A real, same-origin page avoids
 * all of it: the editor writes the draft to `sessionStorage` and opens this
 * URL normally; this page reads it back and paints the DOM itself.
 *
 * Like `/earth/editor`, every request crosses the Access-verifying
 * middleware, so this must stay on-demand.
 */
export const prerender = false;
---

<!doctype html>
<html lang="th">
  <head>
    <script>window.opener = null;</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>Preview · Earth</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=Google+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Thai:wght@400;500;600&display=swap"
    />
    <style is:global>
      /*
       * Global rather than scoped: the cover image, tags, and article body
       * (including inline images and video embeds) are all injected by
       * client script from sessionStorage, not written in this template, so
       * a scope attribute would never reach them — same reasoning as
       * Portal.astro's row template.
       */
      :root { --text: #1a1a1a; --muted: #666; --light: #999; --bg: #fff; --alt: #f7f7f6; --border: #e5e5e5; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Google Sans', system-ui, sans-serif;
        line-height: 1.8;
        -webkit-font-smoothing: antialiased;
      }
      body[data-font='crimson-pro'] { font-family: 'Crimson Pro', Georgia, serif; }
      body[data-font='jetbrains-mono'] { font-family: 'JetBrains Mono', monospace; }
      body[data-font='ibm-plex-sans-thai'] { font-family: 'IBM Plex Sans Thai', system-ui, sans-serif; }
      body[data-font='google-sans'] { font-family: 'Google Sans', system-ui, sans-serif; }
      .scroll { max-width: 720px; margin: 0 auto; padding: 0 24px 96px; }
      .badge {
        position: fixed; top: 16px; right: 16px;
        background: var(--text); color: var(--bg);
        font-family: 'JetBrains Mono', monospace; font-size: 10px;
        padding: 6px 14px; border-radius: 20px; letter-spacing: .08em; text-transform: uppercase;
      }
      .meta { text-align: center; padding: 64px 0 48px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--light); }
      .cover { width: 100%; aspect-ratio: 1.91 / 1; border-radius: 10px; overflow: hidden; background: var(--alt); margin-bottom: 56px; }
      .cover[hidden] { display: none; }
      .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
      header.article { text-align: center; margin-bottom: 56px; }
      h1.title { font-size: 46px; font-weight: 700; line-height: 1.12; letter-spacing: -.02em; margin-bottom: 20px; }
      .excerpt { font-size: 21px; color: var(--muted); font-style: italic; line-height: 1.55; }
      .excerpt[hidden] { display: none; }
      .tags { text-align: center; margin-bottom: 48px; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--light); }
      .tags[hidden] { display: none; }
      hr.divider { border: none; border-top: 1px solid var(--border); margin: 0 0 56px; }
      article { font-size: 20px; }
      article p { margin-bottom: 1.8em; }
      article h1, article h2 { font-size: 30px; font-weight: 700; margin: 2.5em 0 .8em; line-height: 1.2; }
      article h3 { font-size: 24px; font-weight: 600; margin: 2em 0 .8em; }
      article a { color: #22c55e; text-decoration: underline; text-underline-offset: 3px; }
      article blockquote {
        margin: 2.5em 0; padding: 1.2em 1.8em; border-left: 3px solid var(--text);
        background: var(--alt); font-style: italic; color: var(--muted); border-radius: 0 8px 8px 0;
      }
      article ul, article ol { margin: 1.5em 0 1.5em 1.5em; }
      article li { margin-bottom: .5em; }
      article img { max-width: 100%; height: auto; border-radius: 8px; margin: 2.5em 0; display: block; }
      article code { font-family: 'JetBrains Mono', monospace; font-size: .85em; background: var(--alt); padding: .2em .4em; border-radius: 4px; }
      article pre { background: #f6f8fa; padding: 1.5em; border-radius: 8px; overflow-x: auto; margin: 2em 0; }
      article pre code { background: none; padding: 0; }
      article hr { border: none; text-align: center; margin: 3em 0; }
      article hr::before { content: "· · ·"; font-size: 20px; letter-spacing: .3em; color: var(--light); }
      .video-embed { position: relative; width: 100%; padding-bottom: 56.25%; margin: 2em 0; background: #000; border-radius: 8px; overflow: hidden; }
      .video-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
      .missing { text-align: center; padding: 96px 24px; color: var(--muted); font-size: 14px; }
    </style>
  </head>
  <body>
    <div class="badge">Preview</div>
    <div class="scroll" data-earth-preview-root>
      <p class="missing" data-earth-preview-missing hidden>
        No preview data found. Close this tab and click Preview from the editor again.
      </p>
      <div class="meta" data-earth-preview-date hidden></div>
      <div class="cover" data-earth-preview-cover hidden><img alt="" /></div>
      <header class="article">
        <h1 class="title" data-earth-preview-title></h1>
        <p class="excerpt" data-earth-preview-excerpt hidden></p>
      </header>
      <div class="tags" data-earth-preview-tags hidden></div>
      <hr class="divider" data-earth-preview-divider hidden />
      <article data-earth-preview-article></article>
    </div>

    <script>
      interface EarthPreviewPayload {
        title: string;
        excerpt: string;
        cover: string;
        coverCrop: { x: number; y: number; zoom: number } | null;
        tags: string[];
        font: string;
        articleHtml: string;
      }

      const missing = document.querySelector<HTMLElement>('[data-earth-preview-missing]');
      const dateEl = document.querySelector<HTMLElement>('[data-earth-preview-date]');
      const coverEl = document.querySelector<HTMLElement>('[data-earth-preview-cover]');
      const titleEl = document.querySelector<HTMLElement>('[data-earth-preview-title]');
      const excerptEl = document.querySelector<HTMLElement>('[data-earth-preview-excerpt]');
      const tagsEl = document.querySelector<HTMLElement>('[data-earth-preview-tags]');
      const dividerEl = document.querySelector<HTMLElement>('[data-earth-preview-divider]');
      const articleEl = document.querySelector<HTMLElement>('[data-earth-preview-article]');

      const raw = sessionStorage.getItem('earth:preview');
      const data: EarthPreviewPayload | null = raw ? JSON.parse(raw) : null;

      if (!data) {
        if (missing) missing.hidden = false;
      } else {
        document.title = `${data.title || 'Untitled'} — Preview`;
        document.body.dataset.font = data.font || 'google-sans';

        if (dateEl) {
          dateEl.hidden = false;
          dateEl.textContent = new Date().toLocaleDateString(undefined, {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
        }
        if (coverEl && data.cover) {
          coverEl.hidden = false;
          const coverImg = coverEl.querySelector<HTMLImageElement>('img');
          coverImg?.setAttribute('src', data.cover);
          if (coverImg && data.coverCrop) {
            const { x, y, zoom } = data.coverCrop;
            coverImg.style.objectPosition = `${x}% ${y}%`;
            coverImg.style.transform = `scale(${zoom})`;
            coverImg.style.transformOrigin = `${x}% ${y}%`;
          }
        }
        if (titleEl) titleEl.textContent = data.title || 'Untitled';
        if (excerptEl && data.excerpt) {
          excerptEl.hidden = false;
          excerptEl.textContent = data.excerpt;
        }
        if (tagsEl && data.tags?.length > 0) {
          tagsEl.hidden = false;
          tagsEl.textContent = data.tags.map((tag) => `#${tag}`).join(' · ');
        }
        if (dividerEl) dividerEl.hidden = false;
        // Produced by the same renderMarkdown() used for published articles —
        // already escaped/sanitized there, not raw user input.
        if (articleEl) articleEl.innerHTML = data.articleHtml || '';
      }
    </script>
  </body>
</html>
