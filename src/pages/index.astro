---
/**
 * Homepage: direct-SSR reader route. Reads published posts straight from D1
 * at request time — no release/manifest snapshot, no Sanity. Edge-cached so
 * repeat requests within the cache window don't re-hit D1.
 */
import Layout from "@/layouts/Layout.astro";
import HomeIsland from "@/components/HomeIsland";
import { resolveCmsDatabase } from "@/server/cms/api.ts";
import { listPublishedPostCards } from "@/server/cms/repositories/public.ts";
import { publicAssetUrl } from "@/lib/cms/markdown/asset-resolver.ts";
import { PRIMARY_TOPICS } from "@/lib/cms/contracts.ts";

export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=3600, stale-while-revalidate=86400",
);

const db = await resolveCmsDatabase(Astro.locals);
const cards = await listPublishedPostCards(db, { limit: 60 });
const articles = cards.map((card) => ({
  slug: card.slug,
  title: card.title,
  tags: card.tags,
  primaryTopic: card.primaryTopic,
  cover: card.coverAsset
    ? publicAssetUrl(card.coverAsset, "https://images.frong.me")
    : card.coverImageUrl ?? "",
  coverWidth: card.coverAsset?.width,
  coverHeight: card.coverAsset?.height,
}));

---

<Layout>
  <HomeIsland client:load articles={articles} topics={[...PRIMARY_TOPICS]} />
</Layout>
