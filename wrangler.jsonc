{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frong-me",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db-staging",
      "database_id": "71cba742-a269-475d-84b0-8df1223a368a",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "portfolio-media-staging"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "env": {
    "staging": {
      "name": "frong-me-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "portfolio-db-staging",
          "database_id": "71cba742-a269-475d-84b0-8df1223a368a",
          "migrations_dir": "db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "portfolio-media-staging"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    },
    "production": {
      "name": "frong-me",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "portfolio-db-prod",
          "database_id": "e8442532-a929-40d5-8ff4-c05510fad616",
          "migrations_dir": "db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "portfolio-media-prod"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
